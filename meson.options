option(
    'chassis-system-reset',
    type: 'feature',
    value: 'disabled',
    description: 'Enable chassis system power reset to allow removing power and restoring back',
)
option(
    'use-plt-rst',
    type: 'feature',
    value: 'disabled',
    description: 'Use the PLT_RST eSPI signal to detect warm reset instead of POST Complete',
)
option(
    'use-acboot',
    type: 'feature',
    value: 'disabled',
    description: 'Use hardware Reset Reason to control Power Restore. Note: this only works with Intel-BMC',
)
option(
    'ignore-soft-resets-during-post',
    type: 'feature',
    value: 'disabled',
    description: 'Ignore soft resets from host during POST',
)
option(
    'button-passthrough',
    type: 'feature',
    value: 'disabled',
    description: 'Directly couple through power and reset buttons',
)
option(
    'c2-pdb-iox-path',
    type: 'string',
    value: '/sys/bus/i2c/drivers/pca953x/9-0024',
    description: 'C2 PDB IOX PCA953x driver bound path',
)
option(
    'nvl144-pdb-iox-path',
    type: 'string',
    value: '/sys/bus/i2c/drivers/pca953x/9-0020',
    description: 'NVL144 PDB IOX PCA953x driver bound path',
)
option(
    'board0-iox-path',
    type: 'string',
    value: '/sys/bus/i2c/drivers/pca953x/2-0020',
    description: 'Board 0 IOX PCA953x driver bound path',
)
option(
    'board1-iox-path',
    type: 'string',
    value: '/sys/bus/i2c/drivers/pca953x/7-0020',
    description: 'Board 1 IOX PCA953x driver bound path',
)
